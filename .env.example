# Modo Demo (sin contraseña, datos de ejemplo en memoria — ideal para portfolio)
DEMO_MODE=false

# Contraseña/PIN maestro para acceder a la API y a la app desde el móvil (OBLIGATORIO en producción si DEMO_MODE=false)
APP_PASSWORD=cambia-esta-clave-por-una-larga-y-segura

# Base de datos PostgreSQL en la nube (Supabase o Neon). Si se deja vacío, usa data/db.json local.
# Ejemplo Supabase/Neon: postgresql://usuario:password@host:5432/postgres?sslmode=require
DATABASE_URL=

# Notificaciones Web Push reales para iPhone (pantalla bloqueada). Genera claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Ejemplo: https://tu-app.onrender.com o mailto:contacto@tudominio.com
VAPID_SUBJECT=

# Orígenes adicionales permitidos por CORS (separados por coma). En producción suele ir vacío (mismo origen).
# Ejemplo: https://tu-app.onrender.com
ALLOWED_ORIGINS=

# Solo para PC local (sincronización automática al arrancar server.js en local)
RENDER_API_URL=
RENDER_AUTH_TOKEN=

# Solo para PC local (ruta a tu carpeta de sesiones en Obsidian)
# Ejemplo: C:\Users\TuUsuario\Documents\ObsidianVault\Sesiones
OBSIDIAN_VAULT_PATH=
